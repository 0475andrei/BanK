# Supabase - Project Settings > API
# Foloseste cheia "service_role" (NU "anon"/"publishable"): acest cod ruleaza
# doar pe server, are nevoie de acces complet la tabele si trebuie sa ramana
# secreta - nu o expune niciodata intr-un frontend.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=service_role_key_aici

# Optional - configurare server Flask (app.py)
FLASK_PORT=5000
FLASK_DEBUG=false
